    {
      "type": "steps",
      "dur": 5.4,
      "title": "Four questions. That's all.",
      "steps": [
        {
          "head": "What is the product?"
        },
        {
          "head": "Who is it for?"
        },
        {
          "head": "What is the one claim?"
        },
        {
          "head": "What should they do next?"
        }
      ]
    },
    {
      "type": "bullets",
      "dur": 5.6,
      "title": "Then it does the work",
      "numbered": true,
      "items": [
        {
          "head": "Writes the video spec",
          "sub": "Scenes, text and your brand."
        },
        {
          "head": "Checks it",
          "sub": "Exact errors, content rules."
        },
        {
          "head": "Shows a preview",
          "sub": "Every scene on one sheet."
        },
        {
          "head": "Renders every format",
          "sub": "With music and captions."
        }
      ]
    },
    {
      "type": "device",
      "dur": 4.4,
      "kind": "phone",
      "src": "ad_assets/contact_ad.png",
